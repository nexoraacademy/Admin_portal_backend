PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=nexora_academy

# Replace with a long, unique random value before starting the server.
JWT_SECRET=replace-with-a-long-random-secret

# Set a strong local password. This account is seeded as Super Admin once.
ADMIN_NAME=Nexora Administrator
ADMIN_EMAIL=admin@nexoraacademy.co.za
ADMIN_PASSWORD=replace-with-a-strong-local-password

# Configure your academy mailbox SMTP account to send application decisions.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM_NAME=Nexora Academy
SMTP_FROM_EMAIL=admissions@example.com
SMTP_USER=your-mailbox-username
SMTP_PASSWORD=your-mailbox-password
